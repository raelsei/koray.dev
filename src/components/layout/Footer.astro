---
import { SITE } from '../../consts';

const year = new Date().getFullYear();
---

<footer
	class="border-edge text-nano tracking-caps text-soft mt-[88px] flex flex-wrap items-baseline
		justify-between gap-[18px] border-t pt-5 uppercase"
>
	<span>{SITE.title} — {SITE.terminal.city}</span>
	<span>set in jetbrains mono · {SITE.tagline}</span>
	<span>© {year} — exit 0</span>
</footer>
