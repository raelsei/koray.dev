---
import { SITE } from '../../consts';
import { list } from '../../lib/collections';
import { post as postPath } from '../../lib/urls';
import { getPosts } from '../../lib/writing';

const [nav, posts] = await Promise.all([list('nav'), getPosts()]);

// The command bar resolves against the same route table the navigation renders.
const manifest = {
	routes: nav.map(({ id, data }) => ({
		id,
		label: data.label,
		href: data.href,
		aliases: data.aliases,
	})),
	docs: posts.map((post) => ({
		id: post.id,
		title: post.data.title,
		href: postPath(post.id),
	})),
	email: SITE.email,
};
---

<div
	data-command-bar
	transition:persist="command-bar"
	class="bg-void border-edge fixed inset-x-0 bottom-0 z-40 border-t"
>
	<script type="application/json" data-manifest set:html={JSON.stringify(manifest)} is:inline />

	<div class="shell">
		{/* Never toggled with `hidden`: a hidden element is out of the accessibility
		    tree, so mutations to it are not announced. It collapses when empty. */}
		<output data-log role="status" aria-live="polite" class="flex flex-col gap-1"></output>

		<div class="flex h-[46px] items-center gap-2.5">
			<span aria-hidden="true" class="text-code text-lime">$</span>
			<input
				type="text"
				name="command"
				autocomplete="off"
				spellcheck="false"
				aria-label="Terminal command"
				placeholder="try: help, ls, cd work, cat post, mail"
				class="text-code tracking-input text-fg placeholder:text-subtle flex-1 bg-transparent
					outline-none"
			/>
			<span class="text-mini tracking-wide text-subtle whitespace-nowrap uppercase max-sm:hidden">
				↵ run · ⌥/ focus
			</span>
		</div>
	</div>
</div>
