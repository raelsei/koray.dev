---
import { cn } from '../../lib/cn';

interface Props {
	groups: Array<{
		label: string;
		items: Array<{ name: string; note?: string }>;
	}>;
	/** Names the scroll region for assistive tech and keyboard users. */
	label: string;
	class?: string;
}

const { groups, label, class: className } = Astro.props;

// Box-drawing gutters need non-breaking spaces to survive HTML collapsing.
const NBSP = '\u00a0';
const branch = (last: boolean) => (last ? '└── ' : '├── ');
const gutter = (last: boolean) => (last ? NBSP.repeat(4) : `│${NBSP.repeat(3)}`);
---

{/* The glyphs are decoration: the hierarchy is carried by the nested lists, so
    a screen reader hears "editor-and-shell, list of 5 items", not box-drawing
    character names. `tabindex` makes the overflow scrollable without a mouse. */}
<div
	role="group"
	aria-label={label}
	tabindex="0"
	class={cn('flex flex-col gap-6 overflow-x-auto text-item leading-loose', className)}
>
	<ul role="list" class="contents">
		{
			groups.map((group, gi) => {
				const lastGroup = gi === groups.length - 1;
				return (
					<li class="flex flex-col">
						<span class="text-lime whitespace-nowrap">
							<span aria-hidden="true">{branch(lastGroup)}</span>{group.label}/
						</span>
						<ul role="list">
							{group.items.map((item, ii) => (
								<li class="text-fg whitespace-nowrap">
									<span aria-hidden="true">
										{gutter(lastGroup)}
										{branch(ii === group.items.length - 1)}
									</span>
									{item.name}
									{item.note && <span class="text-subtle"> — {item.note}</span>}
								</li>
							))}
						</ul>
					</li>
				);
			})
		}
	</ul>
</div>
