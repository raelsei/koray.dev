---
import { cn } from '../../lib/cn';
import { codeBox } from '../../lib/code-box';

interface Props {
	/** Names the block being copied; three bare "copy" buttons are ambiguous. */
	label: string;
	class?: string;
}

const { label, class: className } = Astro.props;
---

{/* Reads the sibling <pre> inside the enclosing [data-code-box]. */}
<button
	type="button"
	data-copy
	aria-label={`Copy ${label}`}
	class={cn(codeBox.button, className)}
>
	copy
</button>
