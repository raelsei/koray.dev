---
import { Code } from 'astro:components';

import CopyButton from './CopyButton.astro';

import { cn } from '../../lib/cn';
import { codeBox } from '../../lib/code-box';
import { voidTerminal } from '../../lib/shiki-void';

interface Props {
	name: string;
	/** Inline, beside the filename. */
	note?: string;
	/** Block, under the filename. */
	description?: string;
	code: string;
	lang?: string;
	/** Lime rule down the left edge. */
	accent?: boolean;
	class?: string;
}

const {
	name,
	note,
	description,
	code,
	lang = 'text',
	accent = false,
	class: className,
} = Astro.props;
---

{/* For short, inline code. Anything document-length belongs in a Markdown
    collection with its own page — see src/content/prompts. */}
<figure
	data-code-box
	data-accent={accent ? '' : undefined}
	class={cn(codeBox.figure, className)}
>
	<figcaption class={codeBox.caption}>
		<span class="flex items-baseline gap-3">
			<span class="text-md text-fg font-medium">{name}</span>
			{note && <span class="text-row text-soft">{note}</span>}
		</span>
		<CopyButton label={name} />
	</figcaption>
	{description && <p class="text-row leading-body text-soft max-w-[70ch]">{description}</p>}
	<Code code={code.trimEnd()} lang={lang as never} theme={voidTerminal} />
</figure>
