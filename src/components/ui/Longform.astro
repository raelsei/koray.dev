---
import { cn } from '../../lib/cn';

interface Props {
	/** Tailwind `max-w-[NNch]` measure. */
	measure?: string;
	class?: string;
}

const { measure = 'max-w-[78ch]', class: className } = Astro.props;
---

{/* Element styles live in global.css under `.longform` so Markdown output and
    hand-written slots are typeset by exactly one rule set. */}
<div class={cn('longform', measure, className)}>
	<slot />
</div>
