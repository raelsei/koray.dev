---
import { canonical, linkAttrs } from '../../lib/urls';
import { cn } from '../../lib/cn';

interface Props {
	/** Present → the row is a link and gains the hover fill. */
	href?: string;
	/**
	 * Tailwind `grid-cols-[…]` class. Pages override it for bespoke columns;
	 * the default is the label/value pair used across the site.
	 */
	cols?: string;
	/** `sm` single-line · `md` two-line · `lg` archive. */
	pad?: 'sm' | 'md' | 'lg';
	class?: string;
}

const {
	href,
	cols = 'grid-cols-[96px_minmax(0,1fr)] gap-[18px] max-sm:grid-cols-1 max-sm:gap-[7px]',
	pad = 'sm',
	class: className,
} = Astro.props;

const PAD = { sm: 'py-[14px]', md: 'py-[16px]', lg: 'py-[18px]' } as const;

const Tag = href ? 'a' : 'div';
const attrs = href ? { href: canonical(href), ...linkAttrs(href) } : {};
---

<Tag
	{...attrs}
	class={cn(
		'grid items-baseline gap-4',
		cols,
		PAD[pad],
		'border-hair border-b',
		// Links bleed their hover fill past the text column.
		href && '-mx-3 px-3 transition-colors duration-100 hover:bg-panel',
		className,
	)}
>
	<slot name="lead" />
	<slot />
	<slot name="trail" />
</Tag>
