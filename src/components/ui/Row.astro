---
import { cn } from '../../lib/cn';

interface Props {
	/** Present → the row is a link and gains the hover fill. */
	href?: string;
	/** Tailwind `grid-cols-[…]` class. Owned by the page: it is layout, not chrome. */
	cols: string;
	/** `sm` single-line · `md` two-line · `lg` archive. */
	pad?: 'sm' | 'md' | 'lg';
	divider?: boolean;
	class?: string;
}

const { href, cols, pad = 'sm', divider = true, class: className } = Astro.props;

const PAD = { sm: 'py-[14px]', md: 'py-[16px]', lg: 'py-[18px]' } as const;
const external = href?.startsWith('http');

const Tag = href ? 'a' : 'div';
const attrs = href
	? { href, ...(external ? { target: '_blank', rel: 'noreferrer' } : {}) }
	: {};
---

<Tag
	{...attrs}
	class={cn(
		'grid items-baseline gap-4',
		cols,
		PAD[pad],
		divider && 'border-hair border-b',
		// Links bleed their hover fill past the text column.
		href && '-mx-3 px-3 transition-colors duration-100 hover:bg-panel',
		className,
	)}
>
	<slot name="lead" />
	<slot />
	<slot name="trail" />
</Tag>
