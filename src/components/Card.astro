---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { getReadingTime } from "@/utils/getReadingTime";
import Datetime from "./Datetime.astro";

type Props = CollectionEntry<"posts">;

const { id, data, filePath, body } = Astro.props;
const { title, description, pubDatetime, modDatetime, timezone } = data;
---

<li class="group relative border-b py-8">
  <Datetime
    {pubDatetime}
    {modDatetime}
    {timezone}
    readingTime={getReadingTime(body)}
    transitionName={`${toTransitionName(id)}-date`}
  />
  <h2
    class="font-display mt-2 text-[1.625rem] leading-tight font-medium tracking-[-0.02em]"
    transition:name={toTransitionName(id)}
  >
    <a
      href={getPostUrl(id, filePath, Astro.currentLocale)}
      class="link-quiet after:absolute after:inset-0"
    >
      {title}
    </a>
  </h2>
  <p class="text-soft mt-2">{description}</p>
</li>
