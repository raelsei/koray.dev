---
import { cn } from '../../lib/cn';
import type { Tone } from '../../lib/cn';

interface Props {
	tone?: Tone;
	class?: string;
}

const { tone = 'muted', class: className } = Astro.props;
---

<span
	class={cn(
		'text-nano tracking-caps ml-2 font-medium uppercase',
		tone === 'accent' ? 'text-lime' : 'text-subtle',
		className,
	)}
>
	<slot />
</span>
