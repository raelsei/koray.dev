---
type Props = {
  pageTitle: string;
  pageDesc?: string;
  class?: string;
};

const { pageTitle, pageDesc, class: className } = Astro.props;
---

<main
  data-backUrl={Astro.url.pathname}
  id="main-content"
  class:list={["app-layout pt-10 sm:pt-20", className]}
>
  <h1 class="font-display text-[clamp(2.75rem,7vw,4.5rem)] leading-none font-medium tracking-[-0.035em]">
    {pageTitle}
  </h1>
  {pageDesc && <p class="text-soft mt-5 text-lg">{pageDesc}</p>}
  <div class="mt-12 sm:mt-16">
    <slot />
  </div>
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
