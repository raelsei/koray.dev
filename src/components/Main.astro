---
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  pageTitle: string | [string, string];
  pageDesc?: string;
  class?: string;
  /**
   * Local edit. Pairs this h1 with the element that links here, so a View
   * Transition morphs one into the other instead of cross-fading the whole
   * page. Both sides must resolve to the same CSS ident; a name present on
   * only one side animates as an exit and looks like nothing happened.
   *
   * The post detail page sets `view-transition-name` on its own h1 because it
   * does not use this component. Everything that does needs this prop.
   */
  titleTransitionName?: string;
};

const {
  pageTitle,
  pageDesc,
  class: className,
  titleTransitionName,
} = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton
  ? Astro.url.pathname
  : getRelativeLocaleUrl(locale, "");
---

<main
  data-backUrl={backUrl}
  id="main-content"
  class:list={["app-layout pb-4", className]}
>
  <h1
    class="text-2xl font-semibold sm:text-3xl"
    style={
      titleTransitionName
        ? { viewTransitionName: titleTransitionName }
        : undefined
    }
  >
    {pageTitle}
  </h1>
  <p class="mt-2 mb-6 italic">{pageDesc}</p>
  <slot />
</main>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
