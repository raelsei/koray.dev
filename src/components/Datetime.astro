---
import { formatDate } from "@/utils/formatDate";
import { t } from "@/i18n";

type Props = {
  class?: string;
  pubDatetime: Date;
  timezone?: string;
  modDatetime?: Date | null;
  /** Minutes, from `getReadingTime`; omitted where a date stands alone. */
  readingTime?: number;
  /**
   * Without this the post title morphs to the detail page while the date
   * beneath it cross-fades with the rest of the page, so the block splits
   * mid-flight. Must be unique per page and present on both the listing and
   * the detail, or it animates as an exit. See `toTransitionName`.
   */
  transitionName?: string;
};

const {
  pubDatetime,
  modDatetime,
  class: className,
  timezone,
  readingTime,
  transitionName,
} = Astro.props;

const isModified = modDatetime && modDatetime > pubDatetime;
const datetime = isModified ? modDatetime : pubDatetime;
---

<p
  class:list={["text-muted-foreground text-sm tabular-nums", className]}
  style={transitionName ? { viewTransitionName: transitionName } : undefined}
>
  {isModified && <span>{t.post.updatedAt} </span>}
  <time datetime={datetime.toISOString()}>
    {formatDate(datetime, timezone)}
  </time>
  {readingTime !== undefined && (
    <>
      <span aria-hidden="true">&ensp;·&ensp;</span>
      <span>{t.post.readingTime(readingTime)}</span>
    </>
  )}
</p>
