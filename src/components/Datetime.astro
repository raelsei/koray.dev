---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import IconCalendar from "@/assets/icons/IconCalendar.svg";
import config from "@/config";
import { useTranslations } from "@/i18n";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
  /**
   * Local edit. Without this the post title morphs to the detail page while
   * the date directly beneath it cross-fades with the rest of the page, so the
   * block splits mid-flight. Naming both sides moves them together.
   *
   * Must be unique per page and present on both the listing and the detail, or
   * it animates as an exit. See `toTransitionName`.
   */
  transitionName?: string;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
  transitionName,
} = Astro.props;

const t = useTranslations(Astro.currentLocale);

const isModified = modDatetime && modDatetime > pubDatetime;

const datetime = dayjs(isModified ? modDatetime : pubDatetime).tz(
  postTimezone ?? config.site.timezone
);

const date = datetime.format("D MMM, YYYY");
---

<div
  class:list={["text-muted-foreground flex items-center gap-x-2", className]}
  style={transitionName ? { viewTransitionName: transitionName } : undefined}
>
  <IconCalendar
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  {isModified && (
    <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
      {t.post.updatedAt}:
    </span>
  )}
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={datetime.toISOString()}
  >
    {date}
  </time>
</div>
