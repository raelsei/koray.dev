---
import { stripBase } from "@/utils/withBase";
import { t } from "@/i18n";
import config from "@/config";

const path = stripBase(Astro.url.pathname);

// Work and Log are sections of the home page; Writing owns the old /posts/ URLs.
const items = [
  { href: "/#work", label: t.nav.work },
  { href: "/#log", label: t.nav.log },
  {
    href: "/writing/",
    label: t.nav.writing,
    current: path.startsWith("/writing") || path.startsWith("/posts/"),
  },
  { href: "/about/", label: t.nav.about, current: path.startsWith("/about") },
];
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-foreground text-background absolute start-4 -top-full z-50 px-3 py-2 focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header class="app-frame flex items-center justify-between gap-6 py-6 sm:py-8">
  <a
    href="/"
    class="font-display shrink-0 text-xl leading-none font-semibold tracking-[-0.02em] sm:text-2xl"
    aria-current={path === "/" ? "page" : undefined}
  >
    {config.site.title}
  </a>
  <nav aria-label="Main">
    <ul class="text-soft flex gap-x-4 text-[0.9375rem] sm:gap-x-8 sm:text-base">
      {items.map(({ href, label, current }) => (
        <li>
          <a
            {href}
            aria-current={current ? "page" : undefined}
            class="link-quiet hover:text-foreground aria-[current=page]:text-foreground aria-[current=page]:decoration-foreground -my-3 inline-block py-3"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  function handleSkipToContent() {
    const skipLink = document.getElementById("skip-to-content");
    if (!skipLink) return;
    skipLink.addEventListener("click", e => {
      if (
        e.defaultPrevented ||
        e.metaKey ||
        e.ctrlKey ||
        e.shiftKey ||
        e.button !== 0
      )
        return;
      e.preventDefault();
      const target = document.getElementById("main-content");
      if (target) {
        target.setAttribute("tabindex", "-1");
        target.addEventListener(
          "blur",
          () => target.removeAttribute("tabindex"),
          { once: true }
        );
        target.focus();
        target.scrollIntoView({
          behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "auto"
            : "smooth",
        });
      }
    });
  }

  handleSkipToContent();
  document.addEventListener("astro:after-swap", handleSkipToContent);
</script>
