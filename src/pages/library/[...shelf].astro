---
import { getEntry, render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import BaseLayout from '../../layouts/BaseLayout.astro';
import Longform from '../../components/ui/Longform.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Panel from '../../components/ui/Panel.astro';
import Row from '../../components/ui/Row.astro';
import Section from '../../components/ui/Section.astro';

import { breadcrumbs, webPage } from '../../lib/schema';
import { cn } from '../../lib/cn';
import { host } from '../../lib/format';
import { doc as docPath, LIBRARY, shelf as shelfPath } from '../../lib/urls';
import { list } from '../../lib/collections';

/** A docs group is backed by a collection, so its size comes from there. */
const documents = {
	prompts: await list('prompts'),
	snippets: await list('snippets'),
} as const;

const shelfSize = (shelf: CollectionEntry<'shelves'>) =>
	shelf.data.groups.reduce(
		(n, group) =>
			n + (group.kind === 'docs' ? documents[group.collection].length : group.items.length),
		0,
	);

export const getStaticPaths = (async () => {
	const shelves = await list('shelves');
	// The first shelf lives at /library so the section has a canonical root.
	return shelves.map((shelf, i) => ({
		params: { shelf: i === 0 ? undefined : shelf.id },
		props: { active: shelf.id },
	}));
}) satisfies GetStaticPaths;

const { active } = Astro.props;

const page = await getEntry('pages', 'library')!;
const { Content } = await render(page);

const shelves = await list('shelves');
const current = shelves.find((s) => s.id === active)!;

/** Tab counts are derived, so a badge can never disagree with its shelf. */
const path = shelfPath(active, active === shelves[0]!.id);
const schema = [
	webPage(
		{
			path,
			title: `${page.data.head.title} — ${current.id}`,
			description: current.data.description,
			type: 'CollectionPage',
		},
		Astro.site!,
	),
	breadcrumbs(
		path === LIBRARY
			? [{ name: 'Library', path: LIBRARY }]
			: [
					{ name: 'Library', path: LIBRARY },
					{ name: current.id, path },
				],
		Astro.site!,
	),
];

const tabs = shelves.map((shelf, i) => ({
	id: shelf.id,
	href: shelfPath(shelf.id, i === 0),
	count: String(shelfSize(shelf)).padStart(2, '0'),
	active: shelf.id === active,
}));
---

<BaseLayout
	title={`${page.data.title} — ${current.id}`}
	description={current.data.description}
	route="library"
	schema={schema}
>
	<div class="pt-[52px]">
		<PageHeader prompt={page.data.head.prompt} title={page.data.head.title}>
			<Longform measure="max-w-[70ch]" class="animate-rise-in stagger-2 mt-5">
				<Content />
			</Longform>
		</PageHeader>

		<nav aria-label="Shelves" class="rail animate-fade-in stagger-2 mt-10 flex gap-[5px]">
			{
				tabs.map((tab) => (
					<a
						href={tab.href}
						aria-current={tab.active ? 'page' : undefined}
						class={cn(
							'text-meta tracking-label flex flex-none items-baseline gap-2 border px-3 py-2',
							'whitespace-nowrap uppercase transition-colors duration-100',
							tab.active
								? 'border-edge-lime bg-panel text-lime'
								: 'border-edge text-soft hover:border-dim hover:text-fg',
						)}
					>
						<span>--{tab.id}</span>
						<span class="text-micro text-dim">{tab.count}</span>
					</a>
				))
			}
		</nav>

		{
			current.data.groups.map((group, gi) => (
				<Section
					title={group.title}
					meta={group.meta}
					animateRule={gi === 0}
					class={cn('animate-fade-in stagger-3', gi === 0 ? 'mt-[46px]' : 'mt-13')}
				>
					{group.kind === 'docs' &&
						documents[group.collection].map((entry) => (
							<Row
								href={docPath(current.id, entry.id)}
								pad="md"
								cols="grid-cols-[minmax(0,1fr)_130px] max-sm:grid-cols-1 max-sm:gap-[7px]"
							>
								<span class="flex flex-col gap-[5px]">
									<span class="flex flex-wrap items-baseline gap-3">
										<span class="text-item text-fg">{entry.data.title}</span>
										{entry.data.note && (
											<span class="text-row text-subtle">{entry.data.note}</span>
										)}
									</span>
									<span class="text-row leading-row text-soft">{entry.data.description}</span>
								</span>
								<span slot="trail" class="text-meta text-subtle text-right max-sm:text-left">
									read →
								</span>
							</Row>
						))}

					{group.kind === 'link' &&
						group.items.map((item) => (
							<Row
								href={item.href}
								cols="grid-cols-[minmax(0,1fr)_200px] max-sm:grid-cols-1 max-sm:gap-[7px]"
							>
								<span class="text-item text-fg">{item.label}</span>
								<span slot="trail" class="text-meta text-subtle text-right max-sm:text-left">
									{host(item.href)} ↗
								</span>
							</Row>
						))}

					{group.kind === 'repo' &&
						group.items.map((item) => (
							<Row
								href={item.href}
								pad="md"
								cols="grid-cols-[minmax(0,1fr)_130px] max-sm:grid-cols-1 max-sm:gap-[7px]"
							>
								<span class="flex flex-col gap-[5px]">
									<span class="text-item text-fg">{item.name}</span>
									<span class="text-row leading-row text-soft">{item.description}</span>
								</span>
								<span slot="trail" class="text-meta text-subtle text-right max-sm:text-left">
									{item.lang}
								</span>
							</Row>
						))}

					{group.kind === 'card' && (
						<Panel flush cols="grid-cols-2 max-sm:grid-cols-1">
							{group.items.map((item) => (
								<a
									href={item.href}
									target="_blank"
									rel="noreferrer"
									class="hover:bg-panel flex flex-col gap-[7px] p-5 transition-colors duration-100"
								>
									<span class="text-item text-lime">{item.name}</span>
									<span class="text-row leading-snug text-soft">{item.description}</span>
								</a>
							))}
						</Panel>
					)}

				</Section>
			))
		}
	</div>
</BaseLayout>
