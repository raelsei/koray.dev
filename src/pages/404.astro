---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { t } from "@/i18n";
import config from "@/config";
---

<Layout title={`${t.notFound.title} | ${config.site.title}`} noindex>
  <Header />
  <main id="main-content" class="app-frame pt-16 sm:pt-28">
    <h1 class="font-display text-[clamp(5rem,16vw,12rem)] leading-none font-medium tracking-[-0.04em]">
      404
    </h1>
    <p class="text-soft mt-6 text-xl">{t.notFound.message}</p>
    <a href="/" class="link-quiet mt-4 inline-block text-lg">
      {t.notFound.goHome}
    </a>
  </main>
  <Footer />
</Layout>
