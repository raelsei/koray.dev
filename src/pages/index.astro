---
import { getEntry, render } from 'astro:content';

import Cta from '../components/ui/Cta.astro';
import Panel from '../components/ui/Panel.astro';
import Longform from '../components/ui/Longform.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Row from '../components/ui/Row.astro';
import Section from '../components/ui/Section.astro';
import Stat from '../components/ui/Stat.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { list } from '../lib/collections';
import { iso, monthYear, ordinal } from '../lib/format';
import { getPosts } from '../lib/writing';

const page = await getEntry('pages', 'index')!;
const { Content } = await render(page);

const [status, now, ventures, posts] = await Promise.all([
	list('status'),
	list('now'),
	list('ventures'),
	getPosts(),
]);

const latest = posts.slice(0, 3);
---

<BaseLayout title={page.data.title} description={page.data.description} route="index">
	<div class="pt-[52px]">
		<PageHeader size="hero" prompt={page.data.head.prompt} title={page.data.head.title} measure="max-w-[24ch]">
			<Longform measure="max-w-[74ch]" class="mt-2">
				<Content />
			</Longform>
		</PageHeader>

		<Panel cols="grid-cols-4 max-md:grid-cols-2" class="animate-fade-in stagger-2 mt-11">
			{
				status.map((cell) => (
					<Stat
						label={cell.data.label}
						value={cell.data.value}
						note={cell.data.note}
						tone={cell.data.tone}
						live={cell.data.live}
					/>
				))
			}
		</Panel>

		<Section
			title="$ cat now.md"
			meta={monthYear(new Date())}
			animateRule
			class="animate-fade-in stagger-3 mt-[76px]"
		>
			{
				now.map((item) => (
					<Row cols="grid-cols-[112px_minmax(0,1fr)] max-sm:grid-cols-1 max-sm:gap-[7px]">
						<span slot="lead" class="text-meta tracking-label text-dim pt-[3px] uppercase">
							{item.data.label}
						</span>
						<span class="text-base leading-body text-fg">{item.data.body}</span>
					</Row>
				))
			}
		</Section>

		<Section
			title="$ ls -la ./work"
			action="all work →"
			actionHref="/work"
			class="animate-fade-in stagger-4 mt-[66px]"
		>
			{
				ventures.map((venture, i) => (
					<Row
						href="/work"
						pad="md"
						cols="grid-cols-[34px_minmax(0,1fr)_150px] max-sm:grid-cols-1 max-sm:gap-[7px]"
					>
						<span slot="lead" class="text-meta text-dim">{ordinal(i)}</span>
						<span class="flex flex-col gap-1.5">
							<span class="text-lg tracking-snug text-fg font-medium">{venture.data.name}</span>
							<span class="text-sm leading-row text-soft">{venture.data.summary}</span>
						</span>
						<span slot="trail" class="text-meta text-subtle text-right max-sm:text-left">
							{venture.data.status}
							<br />
							{venture.data.period}
						</span>
					</Row>
				))
			}
		</Section>

		<Section
			title="$ ls ./writing | head -3"
			action="archive →"
			actionHref="/writing"
			class="animate-fade-in stagger-5 mt-[66px]"
		>
			{
				latest.map((post) => (
					<Row
						href={`/writing/${post.id}`}
						cols="grid-cols-[minmax(0,1fr)_170px] max-sm:grid-cols-1 max-sm:gap-[7px]"
					>
						<span class="text-body text-fg">{post.id}.md</span>
						<span slot="trail" class="text-meta text-subtle text-right max-sm:text-left">
							{iso(post.data.pubDate)} · {post.minutes} min
						</span>
					</Row>
				))
			}
		</Section>

		{
			page.data.cta && (
				<Cta {...page.data.cta} class="animate-fade-in stagger-6 mt-[76px]" />
			)
		}
	</div>
</BaseLayout>
