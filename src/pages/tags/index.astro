---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/Tag.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { page as pageNode } from "@/utils/schema";
import { useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tags = getUniqueTags(posts);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const schema = [
  pageNode(config, canonical, {
    kind: "CollectionPage",
    name: t.pages.tagsTitle,
    description: t.pages.tagsDesc,
  }),
];
---

<Layout
  title={`${t.pages.tagsTitle} | ${config.site.title}`}
  description={t.pages.tagsDesc}
  canonicalURL={canonical}
  {schema}
>
  <Header />

  <Main pageTitle={t.pages.tagsTitle} pageDesc={t.pages.tagsDesc} class="mt-8">
    <ul class="flex flex-wrap gap-6">
      {tags.map(({ tag, tagName }) => (
        <Tag {tag} {tagName} />
      ))}
    </ul>
  </Main>

  <Footer />
</Layout>
