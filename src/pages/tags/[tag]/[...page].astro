---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { GetStaticPathsOptions } from "astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import LinkButton from "@/components/LinkButton.astro";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import Pagination from "@/components/Pagination.astro";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyAll } from "@/utils/slugify";
import { getPostUrl } from "@/utils/getPostPaths";
import { itemList, page as pageNode } from "@/utils/schema";
import { useTranslations } from "@/i18n";
import config from "@/config";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getSortedPosts(
      posts.filter(({ data }) => slugifyAll(data.tags).includes(tag))
    );

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: config.posts.perPage,
    });
  });
}

const { page, tagName } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const tagDescription = `${t.pages.tagDesc} "${tagName}".`;

const schema = [
  pageNode(config, canonical, {
    kind: "CollectionPage",
    name: `${t.pages.tagTitle}: ${tagName}`,
    description: tagDescription,
  }),
  itemList(
    canonical,
    page.data.map(post => ({
      name: post.data.title,
      url: new URL(getPostUrl(post.id, post.filePath, locale), Astro.site).href,
    }))
  ),
];
---

<Layout
  title={`${t.pages.tagTitle}: ${tagName}${page.currentPage > 1 ? ` (${t.pagination.page} ${page.currentPage})` : ""} | ${config.site.title}`}
  description={tagDescription}
  canonicalURL={canonical}
  {schema}
>
  <Header />

  {/* The nav does not carry Tags, and `Tag.astro` links straight to a single
      tag, so without this link `/tags/` is reachable from nowhere on the site. */}
  <div class="app-layout flex items-center justify-start">
    <LinkButton
      href={getRelativeLocaleUrl(locale, "tags/")}
      class="focus-outline hover:text-foreground/75 -ms-2 mt-8 mb-2"
    >
      <IconChevronLeft class="inline-block size-6 rtl:rotate-180" />
      <span>{t.pages.allTags}</span>
    </LinkButton>
  </div>

  {/* `Tag.astro` already names each chip after the tag slug, but nothing here
      carried the matching name, so that directive animated an exit and read as
      a flicker. Naming the h1 the same makes the chip morph into it. */}
  <Main
    pageTitle={`${t.pages.tagTitle}: ${tagName}`}
    pageDesc={`${t.pages.tagDesc} "${tagName}".`}
    titleTransitionName={Astro.params.tag}
  >
    <ul>
      {page.data.map(data => (
        <Card {...data} />
      ))}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
