---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { itemList, page as pageNode } from "@/utils/schema";
import { t } from "@/i18n";
import config from "@/config";

// Posts keep their /posts/<slug>/ URLs; this is only the index.
const posts = getSortedPosts(await getCollection("posts"));
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const schema = [
  pageNode(config, canonical, {
    kind: "CollectionPage",
    name: t.pages.writingTitle,
    description: t.pages.writingDesc,
  }),
  itemList(
    canonical,
    posts.map(post => ({
      name: post.data.title,
      url: new URL(getPostUrl(post.id, post.filePath), Astro.site).href,
    }))
  ),
];
---

<Layout
  title={`${t.pages.writingTitle} | ${config.site.title}`}
  description={t.pages.writingDesc}
  canonicalURL={canonical}
  {schema}
>
  <Header />
  <Main pageTitle={t.pages.writingTitle}>
    <ul class="border-t">
      {posts.map(post => (
        <Card {...post} />
      ))}
    </ul>
    <p class="text-muted-foreground mt-8 flex gap-6 text-sm">
      <a href="/search/" class="link-quiet hover:text-foreground">
        {t.nav.search}
      </a>
      <a href="/rss.xml" class="link-quiet hover:text-foreground">
        RSS
      </a>
    </p>
  </Main>
  <Footer />
</Layout>
