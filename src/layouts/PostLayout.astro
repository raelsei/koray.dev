---
import Layout from "./Layout.astro";
import { blogPosting, page } from "@/utils/schema";
import config from "@/config";

type Props = {
  /** Document title, suffixed with the site name. */
  title?: string;
  /** The bare post title, used as the JSON-LD headline. */
  headline?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  tags?: string[];
};

const { site } = config;

const {
  title,
  headline,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
} = Astro.props;

const canonical = canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;
const name = headline ?? title ?? site.title;

// The Person, WebSite and BreadcrumbList are added by Layout; this route only
// declares the page and the post, both referencing those by @id.
const schema = [
  page(config, canonical, { kind: "WebPage", name, description }),
  blogPosting(config, canonical, {
    title: name,
    description,
    image: ogImage,
    pubDatetime,
    modDatetime,
    tags,
  }),
];
---

<Layout {title} {description} {ogImage} canonicalURL={canonical} {schema}>
  <Fragment slot="head">
    <!-- Override og:type for article pages -->
    <meta property="og:type" content="article" />

    {pubDatetime && (
      <meta
        property="article:published_time"
        content={pubDatetime.toISOString()}
      />
    )}
    {modDatetime && (
      <meta
        property="article:modified_time"
        content={modDatetime.toISOString()}
      />
    )}
  </Fragment>

  <slot />
</Layout>
