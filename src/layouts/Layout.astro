---
import { Font, getImage } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath } from "@/utils/withBase";
import { graph } from "@/utils/schema";
import portrait from "@/assets/portrait/koray-dark.jpg";
import config from "@/config";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  /**
   * Page-specific JSON-LD nodes. The Person and WebSite are added here, so a
   * route only declares what is unique to itself.
   */
  schema?: Record<string, unknown>[];
  /** Keeps a utility page (search, 404) out of the index while still following links. */
  noindex?: boolean;
};

const { site, profiles } = config;

const {
  title = site.title,
  description = site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  schema = [],
  noindex = false,
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.site ?? Astro.url);

// The Person's `image`: the same portrait the home page shows, as a plain jpg
// a crawler can read.
const personImage = new URL(
  (await getImage({ src: portrait, width: 800, format: "jpg" })).src,
  Astro.site
).href;
---

<!doctype html>
<html
  dir={site.dir ?? "ltr"}
  lang={site.lang}
  class="overflow-y-scroll motion-safe:scroll-smooth"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={getAssetPath("favicon.svg")} />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href={getAssetPath("apple-touch-icon.png")}
    />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    {/* Preloaded so the faces arrive with the HTML; with `display: block` the
        fallback never paints and swaps. */}
    <Font cssVariable="--font-clash" preload />
    <Font cssVariable="--font-switzer" preload={[{ weight: 400 }]} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="sitemap" href={getAssetPath("sitemap-index.xml")} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:site" content="@raelsei" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL("rss.xml", Astro.site)}
    />

    {/* Identity: every profile claims this site back. */}
    {profiles.map(({ url }) => (
      <link rel="me" href={url} />
    ))}
    <link rel="me" href={`mailto:${site.email}`} />

    <meta name="theme-color" content="#08080a" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(
        graph(config, canonicalURL, schema, { image: personImage })
      )}
    ></script>
    <slot name="head" />

    {site.googleVerification && (
      <meta name="google-site-verification" content={site.googleVerification} />
    )}
    <ClientRouter />
  </head>
  <body class="bg-background font-app text-foreground flex min-h-svh flex-col">
    <slot />
  </body>
</html>
